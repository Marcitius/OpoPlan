{
  "name": "opoplan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "vitest run tests/database.test.ts",
    "check": "tsc -b",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "schema:bundle": "node scripts/bundle-schema.mjs",
    "test:live": "node --env-file=.env.live scripts/verify-live.mjs",
    "format": "prettier --write src tests e2e scripts docs *.json *.ts README.md .github/workflows/ci.yml"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@supabase/supabase-js": "^2.57.4",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.2.1",
    "uuid": "^13.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "fake-indexeddb": "^6.2.3",
    "prettier": "^3.6.2",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
